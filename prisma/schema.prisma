// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}


// AUTH (Auth.js / NextAuth) - login & register

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hash bcrypt, buat login credentials (email/password)
  accounts      Account[]
  sessions      Session[]
  role     Role      @default(USER)
  articles Article[]
  comments Comment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
 
  @@map("users")
}
 
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@map("sessions")
}
 
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
 
  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ============================================
// LANDING PAGE CONTENT
// ============================================

model CompanyProfile {
  id          String   @id @default(cuid())
  name        String
  tagline     String?
  logoUrl     String?
  description String?
  address     String?
  phone       String?
  email       String?
  instagram   String?
  facebook    String?
  tiktok      String?
  youtube     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_profile")
}

model HeroSection {
  id          String      @id @default(cuid())
  headline    String
  subheadline String?
  imageUrl    String?
  ctaText     String?
  ctaLink     String?
  isActive    Boolean     @default(true)
  badges      HeroBadge[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("hero_sections")
}

model HeroBadge {
  id            String      @id @default(cuid())
  label         String
  icon          String?
  order         Int         @default(0)
  heroSectionId String
  heroSection   HeroSection @relation(fields: [heroSectionId], references: [id], onDelete: Cascade)

  @@map("hero_badges")
}

model Statistic {
  id        String   @id @default(cuid())
  label     String
  value     String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statistics")
}

model PainPoint {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pain_points")
}

model Solution {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("solutions")
}

// "Apa yang Didapatkan Bunda & Si Kecil?"
model Benefit {
  id          String   @id @default(cuid())
  category    String?
  icon        String?
  title       String
  description String?
  imageUrl    String?
  tags        String[]
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("benefits")
}

model HowItWorksStep {
  id          String   @id @default(cuid())
  stepNumber  Int
  title       String
  description String?
  icon        String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("how_it_works_steps")
}

// "Apa Kata Bunda?" - testimoni umum, standalone
model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  role         String?
  avatarUrl    String?
  message      String
  rating       Int?     @default(5)
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

// ============================================
// TAMBAHAN: Role di User (buat bedain admin)
// ============================================
// Di model User yang udah ada, tambahin field ini:
//
//   role Role @default(USER)
//
// Dan tambahin enum baru:

enum Role {
  USER
  ADMIN
}

// ============================================
// BLOG / ARTIKEL
// ============================================

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  colorTag  String? // buat badge warna: "blue", "purple", "orange", dst
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("article_categories")
}

model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  excerpt     String?
  content     String          @db.Text // rich text HTML dari editor
  coverImageUrl String?
  status      ArticleStatus   @default(DRAFT)
  publishedAt DateTime?
  views       Int             @default(0)
  categoryId  String?
  category    ArticleCategory? @relation(fields: [categoryId], references: [id])
  authorId    String?
  author      User?           @relation(fields: [authorId], references: [id])
  comments    Comment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("articles")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  isActive  Boolean  @default(true) // buat moderasi, sembunyiin tanpa hapus permanen
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

// ============================================
// NEWSLETTER (dari section "Jangan Ketinggalan Info Seru!")
// ============================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ============================================
// CATATAN: model User yang udah ada perlu ditambah 2 relasi ini:
//
//   articles Article[]
//   comments Comment[]
//
// (selain field `role Role @default(USER)` yang disebut di atas)
// ============================================

// ============================================
// E-COMMERCE — KATALOG PRODUK (Tahap 1: Catalog + Smart Filter)
// Belum termasuk: Cart, Order, Payment (menyusul di tahap 2)
// ============================================

model ProductCategory {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  imageUrl  String? // buat tile "Explore by Category" di homepage
  colorTag  String?
  order     Int               @default(0)
  isActive  Boolean           @default(true)

  // Kategori berjenjang: "Mainan Edukasi" > "Board Games"
  parentId  String?
  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")

  products  Product[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("product_categories")
}

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String    @db.Text
  highlights     String[] // bullet manfaat: "Melatih pengenalan pola dan warna", dst

  price          Int // dalam Rupiah, tanpa desimal
  compareAtPrice Int? // harga coret sebelum diskon, null kalau gak ada diskon

  stock          Int       @default(0)
  sku            String?   @unique

  // Atribut buat Smart Filter
  ageMin         Int?
  ageMax         Int?
  skillFocus     String[] // "Kognitif", "Motorik", "STEM", "Bahasa", "Sosial"
  playerCount    String? // "2-4 Pemain", opsional (khusus board game dkk)

  isBestSeller   Boolean   @default(false)
  isFeatured     Boolean   @default(false) // buat "Trending Now"
  isActive       Boolean   @default(true)

  soldCount      Int       @default(0)

  // Placeholder dulu, gampang di-upgrade ke sistem Review beneran nanti
  // (tinggal tambah model Review terpisah, field ini tetap kepake sebagai cache/fallback)
  ratingAvg      Float     @default(0)
  reviewCount    Int       @default(0)

  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])

  images         ProductImage[]
  bundleItems    ProductBundleItem[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  isVideo   Boolean  @default(false)
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// "Rekomendasi Paket Hemat" - bundle 2+ produk dengan harga spesial
model ProductBundle {
  id          String              @id @default(cuid())
  name        String?
  bundlePrice Int // harga total paket setelah diskon
  isActive    Boolean             @default(true)
  items       ProductBundleItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("product_bundles")
}

model ProductBundleItem {
  id        String        @id @default(cuid())
  bundleId  String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  order     Int           @default(0)

  @@map("product_bundle_items")
}