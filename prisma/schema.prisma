// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



// ============================================
// LANDING PAGE CONTENT
// ============================================

model CompanyProfile {
  id          String   @id @default(cuid())
  name        String
  tagline     String?
  logoUrl     String?
  description String?
  address     String?
  phone       String?
  email       String?
  instagram   String?
  facebook    String?
  tiktok      String?
  youtube     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_profile")
}

model HeroSection {
  id          String      @id @default(cuid())
  headline    String
  subheadline String?
  imageUrl    String?
  ctaText     String?
  ctaLink     String?
  isActive    Boolean     @default(true)
  badges      HeroBadge[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("hero_sections")
}

model HeroBadge {
  id            String      @id @default(cuid())
  label         String
  icon          String?
  order         Int         @default(0)
  heroSectionId String
  heroSection   HeroSection @relation(fields: [heroSectionId], references: [id], onDelete: Cascade)

  @@map("hero_badges")
}

model Statistic {
  id        String   @id @default(cuid())
  label     String
  value     String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statistics")
}

model PainPoint {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pain_points")
}

model Solution {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("solutions")
}

// "Apa yang Didapatkan Bunda & Si Kecil?"
model Benefit {
  id          String   @id @default(cuid())
  category    String?
  icon        String?
  title       String
  description String?
  imageUrl    String?
  tags        String[]
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("benefits")
}

model HowItWorksStep {
  id          String   @id @default(cuid())
  stepNumber  Int
  title       String
  description String?
  icon        String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("how_it_works_steps")
}

// "Apa Kata Bunda?" - testimoni umum, standalone
model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  role         String?
  avatarUrl    String?
  message      String
  rating       Int?     @default(5)
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}
